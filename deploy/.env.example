# 超级上下文环境变量示例（占位符，不含真实 key，可提交）
#
# 用法：在 dev 主机生成真实文件（不要回显 key）：
#   sudo install -m 600 -o root -g root /dev/null /opt/super-context/.env
#   sudo vi /opt/super-context/.env       # 粘贴下面的键，填入真实值
#
# 在阿里云百炼控制台创建 API Key 后填入（也可用 `bl auth login` 后从
# ~/.bailian/config.json 读取 api_key / base_url）。不要把真实 key 提交到 Git。

# 必填：百炼 API Key
CONTEXT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 必填：OpenAI 兼容模式 base_url（不要带 /compatible-mode/v1）
# 标准 DashScope 用默认值；Token Plan / 专属工作空间填控制台给的专属地址
CONTEXT_BASE_URL=https://dashscope.aliyuncs.com
# 必填：对外公开前缀，用于 index.md 里的绝对链接
CONTEXT_PUBLIC_PREFIX=https://wkeeli.cn/context

# 以下可选，不写则用默认值
# CONTEXT_VISION_MODEL=qwen3-vl-plus
# CONTEXT_TEXT_MODEL=qwen-plus
# CONTEXT_ASR_MODEL=qwen3-asr-flash
# CONTEXT_MAX_TEXT_CHARS=30000
# CONTEXT_TIMEOUT=120
